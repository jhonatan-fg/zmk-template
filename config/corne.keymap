#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                base {
// -----------------------------------------------------------------------------------------
// | ESC  |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |     |  H  |  J   |  K  |  L  |  ;  |  -   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M   |  ,  |  .  |  [  | ]  |
//                   | LALT | TAB | SPC |     | ENT | WIN  | DEL |
                        bindings = <
   &kp ESC   &kp Q &kp W &kp E &kp R &kp T    &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G    &kp H &kp J  &kp K     &kp L   &kp SEMI &kp MINUS
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B    &kp N &kp M  &kp COMMA &kp DOT &kp LBKT &kp RBKT
              &kp LALT &kp TAB &lt 1 SPACE   &lt 2 ENTER  &kp LWIN  &lt 3 DEL
                        >;
                };
                num_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |      | 1 | 2 | 3 | ^ |     |     |  UP  |     | ` | / | | |
// | CTRL | NLCK | 4 | 5 | 6 | ? |     | LFT | DWN  | RGT |   | + | = |
// | SHFT |      | 7 | 8 | 9 | 0 |     |     |      |     | ' | ( | ) |
//                 |   |   | SPC |     | ENT |   |   |
                        bindings = <
   &kp ESC    &trans    &kp N1  &kp N2  &kp N3 &kp CARET     &trans   &kp UP   &trans    &kp GRAVE &kp FSLH &kp BSLH
   &kp LCTRL  &kp LNLCK &kp N4  &kp N5  &kp N6 &kp QMARK     &kp LEFT &kp DOWN &kp RIGHT &trans    &kp PLUS &kp EQUAL
   &kp LSHFT  &trans    &kp N7  &kp N8  &kp N9 &kp N0        &trans   &trans   &trans    &kp SQT   &kp LPAR &kp RPAR
                                &trans  &trans &kp SPACE     &kp ENTER  &trans   &trans
                        >;
                };

                fn_layer {
// -----------------------------------------------------------------------------------------
// |  F1  |   F2   | F3  | F4  | F5 | F6 |     | F7 | F8 | F9 | F10 | F11 | F12  |
// | CTRL |   BT0  | BT1 | BT2 | BT3| BT4|     |    |    |    |     |     | BOOT |
// | SHFT | BT_CLR |     |     |    |    |     |    |    |    |     |     |      |
//                      |    |     | SPC |     | ENT |    |    |
                        bindings = <
   &kp  F1   &kp F2           &kp F3       &kp F4       &kp F5 &kp F6    &kp F7 &kp F8  &kp F9 &kp F10 &kp F11 &kp F12
   &kp LCTRL &bt BT_SEL 0     &bt BT_SEL 1 &bt BT_SEL 2 &trans &trans    &trans &trans &trans &trans &trans &bootloader
   &kp LSHFT &bt BT_CLR_ALL   &trans       &trans       &trans &trans    &trans &trans &trans &trans &trans &trans
                                              &trans &trans &kp SPACE    &kp ENTER &trans &trans
                        >;
                };

                extra_layer {
// -----------------------------------------------------------------------------------------------------------
// | RGB_TOG | RGB_HUD | RGB_HUI |  | RGB_SPD | RGB_SPI |     |    |    |    |     |     |              |
// | RGB_EFF | RGB_SAD | RGB_SAI |  |         |         |     |    |    |    |     |     | studioUnlock |
// | BL_TOG  | RGB_BRD | RGB_BRI |  |         |         |     |    |    |    |     |     |              |
//                                   |      |     | SPC |     | ENT |    |    |
                        bindings = <
   &rgb_ug RGB_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &trans &rgb_ug RGB_SPD &rgb_ug RGB_SPI     &trans &trans &trans &trans &trans &trans
   &rgb_ug RGB_EFF &rgb_ug RGB_SAD &rgb_ug RGB_SAI &trans &trans          &trans              &trans &trans &trans &trans &trans &studio_unlock
   &bl BL_TOG      &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans &trans          &trans              &trans &trans &trans &trans &trans &trans
                                                                   &trans &trans &kp SPACE    &kp ENTER &trans &trans
                        >;
                };
        };
};

&led_strip { 
        chain-length = <27>;
};
